PORT=8000
LOG_LEVEL=info

# LLM providers — at least one is required for /ask, /rag/query, /sql-agent/query.
# Model id prefix picks the provider: "gpt-"/"o1"/"o3"/"o4"/"chatgpt-" -> OpenAI,
# "claude-" -> Anthropic, "deepseek-" -> DeepSeek (OpenAI-compatible API, much cheaper).
OPENAI_API_KEY=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
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=sk-41e00c1b0ec041509ca0b2a6d143862e
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_REQUEST_TIMEOUT_S=60

# Local embedding model — no API key required. Must produce vectors of
# EMBEDDING_VECTOR_SIZE dimensions, matching backend's QDRANT_VECTOR_SIZE.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384

# Used by the standalone RAG pipeline (app/rag, app/vector_store).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# Hard ceiling on a generated SQL-agent QueryPlan's "limit", regardless of
# what the LLM returns.
SQL_AGENT_MAX_LIMIT=100
